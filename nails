    <style>
        :root {
            --white: #ffffff;
            --cream: #fdfaf7;
            --milk: #faf7f3;
            --beige-light: #f5ede4;
            --beige: #e8d5c4;
            --beige-dark: #d4b896;
            --gold: #c8a882;
            --gold-dark: #b8946e;
            --nude: #d4a574;
            --nude-light: #f0dcc8;
            --gray-50: #f9f8f7;
            --gray-100: #f5f3f1;
            --gray-200: #e8e5e2;
            --gray-300: #d4d1ce;
            --gray-400: #a8a5a2;
            --gray-500: #787572;
            --gray-600: #5c5956;
            --gray-700: #3d3a38;
            --gray-800: #242220;
            --gray-900: #1a1816;
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);
            --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.04);
            --shadow-lg: 0 12px 40px rgba(0, 0, 0, 0.08), 0 4px 12px rgba(0, 0, 0, 0.04);
            --shadow-xl: 0 24px 64px rgba(0, 0, 0, 0.1), 0 8px 24px rgba(0, 0, 0, 0.05);
            --shadow-gold: 0 8px 32px rgba(200, 168, 130, 0.25);
            --radius-sm: 12px;
            --radius-md: 20px;
            --radius-lg: 28px;
            --radius-xl: 36px;
            --radius-full: 9999px;
            --transition-fast: 0.2s cubic-bezier(0.25, 0.1, 0.25, 1);
            --transition-smooth: 0.35s cubic-bezier(0.25, 0.1, 0.25, 1);
            --transition-spring: 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            --font-display: 'Playfair Display', 'Cormorant Garamond', Georgia, serif;
            --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            font-size: 16px;
        }

        body {
            font-family: var(--font-body);
            background: var(--cream);
            color: var(--gray-800);
            line-height: 1.6;
            overflow-x: hidden;
            cursor: default;
            position: relative;
            min-height: 100vh;
        }

        /* Mouse Glow */
        .mouse-glow {
            position: fixed;
            pointer-events: none;
            z-index: 9999;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(212, 165, 116, 0.06) 0%, rgba(212, 165, 116, 0.02) 30%, transparent 70%);
            transform: translate(-50%, -50%);
            transition: opacity 0.4s;
            will-change: left, top;
            opacity: 0;
        }
        body:hover .mouse-glow {
            opacity: 1;
        }

        /* Sticky Header */
        .header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: 16px 0;
            transition: all var(--transition-smooth);
            background: transparent;
        }
        .header.scrolled {
            background: rgba(253, 250, 247, 0.85);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            box-shadow: var(--shadow-md);
            padding: 10px 0;
        }
        .header-inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .logo {
            font-family: var(--font-display);
            font-size: 1.75rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            color: var(--white);
            text-decoration: none;
            transition: color var(--transition-smooth);
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
        }
        .header.scrolled .logo {
            color: var(--gray-800);
            text-shadow: none;
        }
        .nav-links {
            display: flex;
            gap: 32px;
            list-style: none;
            align-items: center;
        }
        .nav-links a {
            text-decoration: none;
            color: rgba(255, 255, 255, 0.9);
            font-size: 0.875rem;
            font-weight: 500;
            letter-spacing: 0.02em;
            transition: color var(--transition-fast);
            position: relative;
        }
        .header.scrolled .nav-links a {
            color: var(--gray-600);
        }
        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 1.5px;
            background: var(--nude);
            transition: width var(--transition-smooth);
        }
        .nav-links a:hover::after {
            width: 100%;
        }
        .nav-links a:hover {
            color: var(--nude);
        }
        .header-cta {
            background: var(--nude);
            color: #fff !important;
            padding: 10px 22px;
            border-radius: var(--radius-full);
            font-weight: 600;
            font-size: 0.85rem;
            letter-spacing: 0.02em;
            transition: all var(--transition-smooth);
            white-space: nowrap;
        }
        .header-cta:hover {
            background: var(--gold-dark);
            box-shadow: var(--shadow-gold);
            transform: translateY(-1px);
        }
        .header-cta::after {
            display: none !important;
        }
        .mobile-menu-btn {

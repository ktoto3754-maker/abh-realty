            padding-left: 40px;
        }
        .timeline::before {
            content: '';
            position: absolute;
            left: 18px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: var(--beige);
            border-radius: 1px;
        }
        .timeline-step {
            position: relative;
            padding: 0 0 40px 40px;
        }
        .timeline-step:last-child {
            padding-bottom: 0;
        }
        .timeline-dot {
            position: absolute;
            left: -31px;
            top: 4px;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--white);
            border: 3px solid var(--nude);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: var(--nude);
            font-size: 0.9rem;
            z-index: 1;
            transition: all var(--transition-smooth);
        }
        .timeline-step:hover .timeline-dot {
            background: var(--nude);
            color: #fff;
            box-shadow: var(--shadow-gold);
        }
        .timeline-step-title {
            font-family: var(--font-display);
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 4px;
        }
        .timeline-step-desc {
            font-size: 0.9rem;
            color: var(--gray-500);
            line-height: 1.5;
        }

        /* Testimonials */
        .testimonials-slider {
            position: relative;
            overflow: hidden;
            max-width: 700px;
            margin: 0 auto;
        }
        .testimonials-track {
            display: flex;
            transition: transform 0.5s cubic-bezier(0.25, 0.1, 0.25, 1);
        }
        .testimonial-slide {
            min-width: 100%;
            padding: 20px;
        }
        .testimonial-card {
            background: var(--white);
            border-radius: var(--radius-lg);
            padding: 36px 30px;
            box-shadow: var(--shadow-md);
            text-align: center;
            position: relative;
        }
        .testimonial-stars {
            color: #e8c46a;
            font-size: 1.1rem;
            letter-spacing: 3px;
            margin-bottom: 16px;
        }
        .testimonial-text {
            font-size: 0.95rem;
            color: var(--gray-600);
            line-height: 1.7;
            font-style: italic;
            margin-bottom: 20px;
        }
        .testimonial-author {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }
        .testimonial-author img {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            object-fit: cover;
        }
        .testimonial-author-name {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--gray-800);
            text-align: left;
        }
        .testimonial-author-date {
            font-size: 0.78rem;
            color: var(--gray-400);
            text-align: left;
        }
        .testimonial-dots {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 24px;
        }
        .testimonial-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--gray-300);
            cursor: pointer;
            transition: all var(--transition-fast);
            border: none;
        }
        .testimonial-dot.active {
            background: var(--nude);
            width: 28px;
            border-radius: 20px;
        }

        /* Pricing */
        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }
        .pricing-card {
            background: var(--white);
            border-radius: var(--radius-lg);
            padding: 28px 22px;
            box-shadow: var(--shadow-sm);
            text-align: center;
            transition: all var(--transition-smooth);
            position: relative;
        }
        .pricing-card:hover {
            box-shadow: var(--shadow-xl);
            transform: translateY(-3px);
        }
        .pricing-card.featured {
            border: 2px solid var(--nude);
            box-shadow: var(--shadow-gold);
        }
        .pricing-card.featured::after {
            content: 'Популярное';
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--nude);
            color: #fff;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 5px 16px;
            border-radius: var(--radius-full);
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .pricing-card-title {
            font-family: var(--font-display);
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 4px;
        }
        .pricing-card-desc {
            font-size: 0.8rem;
            color: var(--gray-500);
            margin-bottom: 14px;
            line-height: 1.4;
        }
        .pricing-card-price {
            font-size: 2rem;
            font-weight: 700;
            color: var(--nude);
            font-family: var(--font-display);
        }
        .pricing-card-price span {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--gray-500);
        }
        .pricing-card .btn {
            margin-top: 14px;
            width: 100%;
            padding: 11px 20px;
            font-size: 0.8rem;
            background: var(--gray-100);
            color: var(--gray-700);
            border-radius: var(--radius-full);
        }
        .pricing-card .btn:hover {
            background: var(--nude);
            color: #fff;
            box-shadow: var(--shadow-gold);
        }

        /* FAQ */
        .faq-list {
            max-width: 760px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .faq-item {
            background: var(--white);
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: all var(--transition-smooth);
        }
        .faq-item:hover {
            box-shadow: var(--shadow-md);
        }
        .faq-question {
            width: 100%;
            background: none;
            border: none;
            padding: 22px 28px;
            font-family: var(--font-body);
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--gray-800);
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            text-align: left;
            gap: 16px;
            transition: color var(--transition-fast);
        }
        .faq-question:hover {
            color: var(--nude);
        }
        .faq-icon {
            flex-shrink: 0;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--beige-light);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all var(--transition-smooth);
            font-size: 1.2rem;
            color: var(--nude);
            font-weight: 500;
            line-height: 1;
        }
        .faq-item.active .faq-icon {
            transform: rotate(45deg);
            background: var(--nude);
            color: #fff;
        }
        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s cubic-bezier(0.25, 0.1, 0.25, 1), padding 0.4s;
            padding: 0 28px;
            font-size: 0.88rem;
            color: var(--gray-600);
            line-height: 1.7;
        }
        .faq-item.active .faq-answer {
            max-height: 300px;
            padding: 0 28px 22px;
        }

        /* CTA Section */
        .cta-section {
            position: relative;
            background: var(--gray-900);
            border-radius: var(--radius-xl);
            overflow: hidden;
            margin: 0 40px;
            max-width: 1200px;
            margin-left: auto;
            margin-right: auto;
            text-align: center;
            padding: 80px 40px;
        }
        .cta-bg {
            position: absolute;
            inset: 0;
            z-index: 0;
        }
        .cta-bg img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: brightness(0.35);
        }
        .cta-content {
            position: relative;
            z-index: 1;
            max-width: 600px;
            margin: 0 auto;
        }
        .cta-title {
            font-family: var(--font-display);
            font-size: clamp(2rem, 4vw, 2.8rem);
            color: #fff;
            font-weight: 600;
            margin-bottom: 16px;
            letter-spacing: 0.02em;
        }
        .cta-subtitle {
            font-size: 1.05rem;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 32px;
            line-height: 1.6;
        }
        .cta-section .btn-primary {
            font-size: 1rem;
            padding: 16px 40px;
        }

        /* Footer */
        .footer {
            background: var(--gray-800);
            color: rgba(255, 255, 255, 0.7);
            padding: 60px 40px 30px;
            margin-top: 100px;
        }
        .footer-inner {
            max-width: 1280px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1.5fr;
            gap: 40px;
        }
        .footer-logo {
            font-family: var(--font-display);
            font-size: 1.8rem;
            color: #fff;
            font-weight: 600;
            letter-spacing: 0.04em;
            margin-bottom: 12px;
        }
        .footer-about {
            font-size: 0.85rem;
            line-height: 1.6;
            color: rgba(255, 255, 255, 0.5);
            max-width: 280px;
        }
        .footer h4 {
            font-family: var(--font-display);
            font-size: 1rem;
            color: #fff;
            margin-bottom: 16px;
            font-weight: 500;
            letter-spacing: 0.02em;
        }
        .footer ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .footer a {
            color: rgba(255, 255, 255, 0.6);
            text-decoration: none;
            font-size: 0.85rem;
            transition: color var(--transition-fast);
        }
        .footer a:hover {
            color: var(--nude);
        }
        .footer-map {
            width: 100%;
            height: 140px;
            border-radius: var(--radius-md);
            background: var(--gray-700);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            color: rgba(255, 255, 255, 0.4);
            margin-top: 8px;
            overflow: hidden;
        }
        .footer-map iframe {
            width: 100%;
            height: 100%;
            border: none;
            filter: grayscale(0.8) brightness(0.9);
        }
        .footer-bottom {
            max-width: 1280px;
            margin: 30px auto 0;
            padding-top: 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            text-align: center;
            font-size: 0.78rem;
            color: rgba(255, 255, 255, 0.35);
        }

        /* Back to Top */
        .back-to-top {
            position: fixed;
            bottom: 28px;
            right: 28px;
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: var(--white);
            border: 1.5px solid var(--gray-200);
            cursor: pointer;
            z-index: 900;
            box-shadow: var(--shadow-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: var(--gray-600);
            transition: all var(--transition-smooth);
            opacity: 0;
            pointer-events: none;
        }
        .back-to-top.visible {
            opacity: 1;
            pointer-events: all;
        }
        .back-to-top:hover {
            background: var(--nude);
            color: #fff;
            border-color: var(--nude);
            box-shadow: var(--shadow-gold);
            transform: translateY(-2px);
        }

        /* Floating CTA */
        .floating-cta {
            position: fixed;
            bottom: 28px;
            left: 28px;
            z-index: 900;
            background: var(--nude);
            color: #fff;
            border-radius: var(--radius-full);
            padding: 13px 26px;
            font-weight: 600;
            font-size: 0.85rem;
            letter-spacing: 0.02em;
            cursor: pointer;
            border: none;
            box-shadow: var(--shadow-gold);
            transition: all var(--transition-smooth);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .floating-cta:hover {
            background: var(--gold-dark);
            transform: translateY(-2px);
            box-shadow: 0 12px 36px rgba(200, 168, 130, 0.4);
        }

        /* Reveal */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.7s cubic-bezier(0.25, 0.1, 0.25, 1), transform 0.7s cubic-bezier(0.25, 0.1, 0.25, 1);
        }
        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }
        .reveal-delay-1 {
            transition-delay: 0.1s;
        }
        .reveal-delay-2 {
            transition-delay: 0.2s;
        }
        .reveal-delay-3 {
            transition-delay: 0.3s;
        }
        .reveal-delay-4 {
            transition-delay: 0.4s;
        }

        /* Mobile Nav */
        .mobile-nav {
            position: fixed;
            inset: 0;
            z-index: 999;
            background: rgba(253, 250, 247, 0.98);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 28px;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.35s;
        }
        .mobile-nav.active {
            opacity: 1;
            pointer-events: all;
        }
        .mobile-nav a {
            font-family: var(--font-display);
            font-size: 1.5rem;
            color: var(--gray-800);
            text-decoration: none;
            font-weight: 500;
            transition: color var(--transition-fast);
        }
        .mobile-nav a:hover {
            color: var(--nude);
        }

        /* Responsive */
        @media (max-width: 1100px) {
            .hero-content {
                grid-template-columns: 1fr;
                gap: 40px;
                text-align: center;
            }
            .hero-text {
                max-width: 100%;
            }
            .hero-subtitle {
                max-width: 100%;
                margin-left: auto;
                margin-right: auto;
            }
            .hero-buttons {
                justify-content: center;
            }
            .hero-card {
                max-width: 420px;
                margin: 0 auto;
            }
            .services-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .why-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .gallery-masonry {
                columns: 2;
            }
            .masters-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .pricing-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .footer-inner {
                grid-template-columns: 1fr 1fr;
            }
        }
        @media (max-width: 768px) {
            .section {
                padding: 60px 20px;
            }
            .header-inner {
                padding: 0 20px;
            }
            .nav-links {
                display: none;
            }
            .mobile-menu-btn {
                display: flex;
            }
            .hero-content {
                padding: 100px 20px 60px;
            }
            .hero-title {
                font-size: 2rem;
            }
            .services-grid {
                grid-template-columns: 1fr 1fr;
                gap: 14px;
            }
            .why-grid {
                grid-template-columns: 1fr;
                gap: 14px;
            }
            .gallery-masonry {
                columns: 1;
            }
            .masters-grid {
                grid-template-columns: 1fr 1fr;
                gap: 14px;
            }
            .pricing-grid {
                grid-template-columns: 1fr 1fr;
                gap: 14px;
            }
            .footer-inner {
                grid-template-columns: 1fr;
                gap: 28px;
            }
            .cta-section {
                margin: 0 16px;
                padding: 50px 20px;
                border-radius: var(--radius-lg);
            }
            .section-title {
                font-size: 1.6rem;
            }
            .hero-card {
                padding: 20px 18px;
                gap: 14px;
            }
            .hero-card-item {
                font-size: 0.8rem;
            }
            .floating-cta {
                bottom: 16px;
                left: 16px;
                padding: 11px 20px;
                font-size: 0.78rem;
            }
            .back-to-top {
                bottom: 16px;
                right: 16px;
                width: 40px;
                height: 40px;
            }
        }
        @media (max-width: 480px) {
            .services-grid {
                grid-template-columns: 1fr;
            }
            .masters-grid {
                grid-template-columns: 1fr;
            }
            .pricing-grid {
                grid-template-columns: 1fr;
            }
            .hero-buttons {
                flex-direction: column;
                align-items: center;
            }
            .hero-buttons .btn {
                width: 100%;
                max-width: 300px;
            }
            .gallery-filters {
                gap: 8px;
            }
            .gallery-filter {
                padding: 8px 16px;
                font-size: 0.78rem;
            }
            .hero-title {
                font-size: 1.7rem;
            }
        }
    </style>
</head>
